# Settings for the frontend. Copy this file to ".env" (in this same folder) and edit the copy.
# Vite reads it when `npm run dev` starts (restart after editing) and bakes it into `npm run build`.
# Only names starting with VITE_ reach the browser, and everything here is visible to anyone who opens the site,
# so never put a secret in this file.

# Where the backend is. Default: http://localhost:5000
VITE_API_URL=http://localhost:5000
