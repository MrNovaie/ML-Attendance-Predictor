# Settings for the backend. Copy this file to ".env" (in this same folder) and edit the copy.
# .env is never committed (it is in .gitignore): it holds secrets. A real environment variable beats this file.
#
# Leave a line out, or keep it commented with #, to use the default shown.

# --- Always -----------------------------------------------------------------------------------------
# Where the browser may call the API from: the address people open the app at, exactly as the browser shows it
# (scheme and port, no path, no trailing slash). Several, separated by commas. Default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Production (set ENV=production on the real server) ----------------------------------------------
# With ENV=production the server REFUSES TO START unless SECRET_KEY, ACTIVITY_LOG_KEY and CORS_ORIGIN are set,
# and the session cookie is marked Secure (so people must reach the app over HTTPS).
#ENV=production

# Signs login sessions. A long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
#SECRET_KEY=

# Keys the activity log's tamper-evident hashes. Another long random string, kept secret, and NEVER changed for an
# existing database (every older log entry would then fail the check). Keep a copy somewhere safe.
#ACTIVITY_LOG_KEY=

# Only for a server reached over plain http:// on a trusted private network. With the Secure cookie on (production
# default) a browser refuses the cookie over plain http and nobody can log in. 0 turns it off: passwords then travel
# unencrypted, so use it only where that is acceptable.
#COOKIE_SECURE=0

# --- Optional ------------------------------------------------------------------------------------------
# Set to 1, true or yes to let people register themselves on the login screen (an admin still has to link them).
#ALLOW_REGISTRATION=1

# Where the database lives. Default: backend/attendance.db
#DATABASE_URL=sqlite:///C:/path/to/attendance.db

# For `python app.py`: HOST=0.0.0.0 lets other computers on the network reach it (default: this computer only).
#HOST=0.0.0.0
#PORT=5000
